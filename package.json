{
  "name": "agent-workspace",
  "private": true,
  "scripts": {
    "ask": "pnpm --silent --filter @repo/discord-app ask",
    "ask:continue": "pnpm --silent --filter @repo/discord-app ask:continue",
    "lint": "oxlint discord shared",
    "lint:fix": "pnpm run lint --fix --fix-suggestions",
    "test": "pnpm -r test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.14.0"
  },
  "packageManager": "pnpm@11.25.0"
}
